# MKV Video Player - Environment Configuration
# Copy this file to .env and customize as needed

# ===========================
# Server Configuration
# ===========================
PORT=3000
HOST=localhost
NODE_ENV=production
APP_VERSION=1.01
# ===========================
# Logging
# ===========================
# Options: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO

# ===========================
# Security
# ===========================
# Set to true if behind a proxy (Nginx, Apache, etc.)
TRUST_PROXY=false

# CORS origin (use specific domain in production)
CORS_ORIGIN=*

# ===========================
# Torrent Configuration
# ===========================
# Maximum peer connections
MAX_CONNECTIONS=50

# Downloads directory (absolute or relative path)
DOWNLOADS_DIR=./downloads

# Temporary files directory
TEMP_DIR=./temp

# ===========================
# Performance
# ===========================
# Maximum number of items in cache
CACHE_MAX_SIZE=50

# Maximum concurrent torrents
MAX_CONCURRENT_TORRENTS=15

# ===========================
# Electron (Desktop App)
# ===========================
# Set to 1 for development mode
ELECTRON_IS_DEV=0

# ===========================
# Advanced Settings (Optional)
# ===========================
# Upload speed limit in bytes/sec (2MB/s = 2097152)
# UPLOAD_LIMIT=2097152

# Download speed limit (-1 = unlimited)
# DOWNLOAD_LIMIT=-1

# Request timeout in milliseconds
# REQUEST_TIMEOUT=120000

# Rate limit window in milliseconds
# RATE_LIMIT_WINDOW=900000
