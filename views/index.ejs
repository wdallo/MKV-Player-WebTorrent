<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>
      <%= pageTitle || "MKV Player" %> - v<%= appVersion || "dev" %>
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/libs/styles/style-min.css" />
  </head>
  <body>
    <main class="container">
      <!-- <h1>Load Torrent</h1> -->
      <div class="tabs">
        <button type="button" class="tab-btn active" data-tab="magnet">
          Magnet URL
        </button>
        <button type="button" class="tab-btn" data-tab="torrent">
          Torrent File
        </button>
        <button
          type="button"
          class="tab-btn"
          id="browse-tab-btn"
          data-tab="browser"
          style="display: none"
        >
          Browse Sites
        </button>
      </div>

      <!-- Magnet URL Tab -->
      <div id="magnet-tab" class="tab-content active">
        <form id="magnet-form" class="magnet-form">
          <input
            type="text"
            id="magnet-url"
            name="url"
            placeholder="Paste magnet:?xt=..."
            class="magnet-form-input"
            required
          />
          <div class="magnet-form-helper">
            Example:
            <code>magnet:?xt=urn:btih:QQSOBFAQDJ4A4ROQILCNMHDGP2BT72J5</code>
          </div>
          <button type="submit" class="magnet-form-btn">Load Magnet</button>
        </form>
      </div>

      <!-- Torrent File Tab -->
      <div id="torrent-tab" class="tab-content">
        <form id="torrent-form" class="magnet-form">
          <div class="file-upload-area" id="file-upload-area">
            <input
              type="file"
              id="torrent-file"
              accept=".torrent"
              style="display: none"
            />
            <div class="file-upload-content">
              <p>Drop a .torrent file here or click to select</p>
              <button
                type="button"
                id="choose-file-btn"
                class="magnet-form-btn"
              >
                Choose Torrent File
              </button>
            </div>
          </div>
          <div id="file-info" class="file-info" style="display: none">
            <p id="file-name"></p>
            <button type="submit" class="magnet-form-btn">
              Parse & Load Torrent
            </button>
          </div>
        </form>
      </div>

      <!-- Browser Tab -->
      <div
        id="browser-tab"
        class="tab-content"
        style="
          display: none;
          flex-direction: column;
          height: calc(100vh - 120px);
        "
      >
        <div
          class="browser-container"
          style="
            max-width: 100%;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            flex: 1;
            min-height: 0;
          "
        >
          <!-- Toolbar -->
          <div
            style="
              background: #1e1e1e;
              padding: 12px 20px;
              display: flex;
              gap: 10px;
              align-items: center;
              border-bottom: 1px solid #333;
            "
          >
            <button type="button" id="back-btn" class="nav-btn" title="Back">
              ◄
            </button>
            <button
              type="button"
              id="forward-btn"
              class="nav-btn"
              title="Forward"
            >
              ►
            </button>
            <button
              type="button"
              id="refresh-btn"
              class="nav-btn"
              title="Refresh"
            >
              ⟳
            </button>
            <button
              type="button"
              id="close-browser-btn"
              class="nav-btn"
              title="Close Browser"
              style="
                background: rgba(239, 68, 68, 0.2);
                border-color: rgba(239, 68, 68, 0.3);
              "
            >
              ✕
            </button>
            <input
              type="url"
              id="site-url"
              placeholder="Enter torrent site URL..."
              class="magnet-form-input"
              value=""
              style="flex: 1; margin: 0"
            />
            <button
              type="button"
              id="load-site-btn"
              class="magnet-form-btn"
              style="margin: 0"
            >
              Go
            </button>
          </div>

          <!-- Quick Links Bar -->
          <div
            style="
              background: #252525;
              padding: 10px 20px;
              display: flex;
              gap: 8px;
              border-bottom: 1px solid #333;
              overflow-x: auto;
            "
          >
            <button
              type="button"
              class="quick-link-btn-small"
              data-url="https://subsplease.org"
            >
              🌸 SubsPlease
            </button>

            <button
              type="button"
              class="quick-link-btn-small"
              data-url="https://nyaa.si"
            >
              🐱 Nyaa.si
            </button>
            <button
              type="button"
              class="quick-link-btn-small"
              data-url="https://1337x.to"
            >
              ⚡ 1337x
            </button>
            <button
              type="button"
              class="quick-link-btn-small"
              data-url="https://thepiratebay.org"
            >
              🏴‍☠️ TPB
            </button>
          </div>

          <!-- Browser View Info -->
          <div
            id="browser-active-msg"
            style="
              display: none;
              padding: 15px 20px;
              background: rgba(16, 185, 129, 0.1);
              border-bottom: 1px solid rgba(16, 185, 129, 0.3);
            "
          >
            <p style="color: #10b981; font-size: 13px; margin: 0">
              ✓ <strong>Browser active!</strong> Click the purple "▶ Play"
              button next to any magnet link to load it directly
            </p>
          </div>

          <!-- Browser placeholder -->
          <div
            id="browser-placeholder"
            style="
              flex: 1;
              display: flex;
              align-items: center;
              justify-content: center;
              background: #1a1a1a;
              position: relative;
              overflow: hidden;
            "
          >
            <div id="placeholder-text" style="text-align: center; color: #666">
              <div style="font-size: 48px; margin-bottom: 20px">🌐</div>
              <p style="font-size: 18px; margin-bottom: 10px; color: #aaa">
                Click a site above or enter a URL
              </p>
              <p style="font-size: 14px">The browser will appear here</p>
            </div>
            <div
              id="browser-loading"
              style="
                display: none;
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: #1a1a1a;
                align-items: center;
                justify-content: center;
                z-index: 10;
              "
            >
              <div style="text-align: center">
                <div
                  style="
                    width: 50px;
                    height: 50px;
                    border: 4px solid #333;
                    border-top-color: #8b5cf6;
                    border-radius: 50%;
                    animation: spin 1s linear infinite;
                    margin: 0 auto 20px;
                  "
                ></div>
                <p style="color: #aaa; font-size: 16px">Loading...</p>
              </div>
            </div>
            <webview
              id="browser-webview"
              style="
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                display: none;
              "
              partition="persist:browser"
            ></webview>
          </div>
        </div>
      </div>
      <div
        id="magnet-error"
        class="magnet-form-error"
        style="display: none"
      ></div>
      <div id="loading" class="loading" style="display: none">
        <p>Parsing torrent file...</p>
      </div>
    </main>

    <footer class="footer">
      Created with ❤️ by
      <a href="https://github.com/wdallo" target="_blank"> wdallo </a>
    </footer>

    <script src="/libs/torrentParser-min.js"></script>
    <script src="/libs/pageScript.js"></script>
  </body>
</html>
