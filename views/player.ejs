<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>MKV Video Player</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="preload" as="style" href="/libs/styles/plyr.css" />
    <link rel="stylesheet" href="/libs/styles/plyr.css" />
    <link rel="stylesheet" href="/libs/styles/style.css" />

    <script src="/libs/octopus/subtitles-octopus.js"></script>
  </head>
  <body>
    <main class="container">
      <header style="position: relative">
        <h1>MKV Video Player</h1>
        <a href="/" class="back-btn back-btn-topright">← Back to Home</a>
      </header>

      <!-- Download Status Section -->
      <section class="status-section">
        <div class="status-details" id="status-details">&nbsp;</div>
        <div class="progress-container">
          <div class="progress-bar" id="progress-bar"></div>
        </div>
        <div
          id="preload-indicator"
          class="preload-indicator"
          style="display: none"
        >
          <div class="preload-info">
            <span class="preload-label">Video Buffer:</span>
            <span id="video-buffer-status" class="preload-value">0%</span>
            <span class="preload-separator">|</span>
            <span class="preload-label">Subtitles:</span>
            <span id="subtitle-preload-status" class="preload-value"
              >Loading...</span
            >
          </div>
        </div>
        <div id="loading">Loading video and subtitles, please wait...</div>
        <div id="status-msg"></div>
        <div id="error"></div>
        <button id="retry-btn" class="retry-button">Retry Video Load</button>
      </section>

      <!-- Video Player Section -->
      <section id="video-container" class="video-container-main">
        <div id="plyr-loading-overlay" class="plyr-loading-overlay">
          <div style="text-align: center">
            <div class="plyr-spinner"></div>
            <div class="plyr-loading-text">Loading video player...</div>
          </div>
        </div>
        <div class="video-container-tag">
          <video
            id="player"
            class="hidden-until-plyr video-player-tag"
            controls
            crossorigin
            playsinline
            preload="metadata"
            width="850"
          ></video>
          <!-- Watermark Overlay -->
          <div class="video-watermark"></div>

          <!-- Resume/Start Module -->
          <div
            id="resume-module"
            class="resume-module"
            role="dialog"
            aria-labelledby="resume-title"
            aria-modal="true"
          >
            <div id="resume-module-inner" class="resume-module-inner">
              <div id="resume-title" class="playback-title">
                Resume playback?
              </div>
              <button id="resume-btn" class="resume-button">
                Resume from last position
              </button>
              <button id="restart-btn" class="start-from-beginning-button">
                Start from beginning
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>
    <!-- Embed Box:  -->
    <div style="margin: 32px auto 0 auto; max-width: 600px; text-align: center">
      <label
        for="embed-code"
        style="font-weight: 500; color: #fff; font-size: 1.1em"
      >
        Embed this player:
      </label>
      <input
        id="embed-code"
        type="text"
        readonly
        value=""
        style="
          width: 95%;
          margin-top: 10px;
          padding: 8px;
          font-size: 1em;
          border-radius: 6px;
          border: 1px solid #444;
          background: #222;
          color: #fff;
        "
        onclick="this.select();"
      />
      <script>
        document.addEventListener("DOMContentLoaded", () => {
          const magnetUrl = decodeURIComponent(
            "<%- encodeURIComponent(magnet) %>"
          );
          const embedInput = document.getElementById("embed-code");
          embedInput.value = `<iframe src="${
            window.location.origin
          }/embed?url=${encodeURIComponent(
            magnetUrl
          )}" width="640" height="360" frameborder="0" allowfullscreen></iframe>`;
        });
      </script>
    </div>
    <footer class="footer">
      Created with ❤️ by
      <a href="https://github.com/wdallo" target="_blank"> wdallo </a>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/plyr@3.7.8/dist/plyr.polyfilled.js"></script>
    <script type="module">
      // Import the VideoPlayerController class
      import { VideoPlayerController } from "../libs/player.js";

      // Initialize the application with error handling
      document.addEventListener("DOMContentLoaded", async () => {
        try {
          const magnetUrl = decodeURIComponent(
            "<%- encodeURIComponent(magnet) %>"
          );

          if (!magnetUrl) {
            console.error("No magnet URL provided");
            return;
          }

          console.log("Initializing player with magnet:", magnetUrl);

          const player = new VideoPlayerController(magnetUrl);

          // Make player globally accessible for context menu and debugging
          window.player = player;

          // Initialize with error handling
          await player.initialize();

          console.log("✅ Player initialized successfully");
        } catch (error) {
          console.error("❌ Failed to initialize player:", error);

          // Show error in overlay if available
          const overlay = document.getElementById("plyr-loading-overlay");
          if (overlay) {
            // Clear existing content safely
            overlay.textContent = "";

            // Create error container
            const errorContainer = document.createElement("div");
            errorContainer.style.textAlign = "center";
            errorContainer.style.color = "#fff";
            errorContainer.style.padding = "20px";

            // Create icon
            const iconDiv = document.createElement("div");
            iconDiv.textContent = "⚠️";
            iconDiv.style.fontSize = "2em";
            iconDiv.style.marginBottom = "10px";

            // Create title
            const titleDiv = document.createElement("div");
            titleDiv.textContent = "Player Error";
            titleDiv.style.fontSize = "1.2em";
            titleDiv.style.marginBottom = "10px";

            // Create message
            const messageDiv = document.createElement("div");
            messageDiv.textContent = error.message || "Unknown error occurred";
            messageDiv.style.opacity = "0.8";

            // Create retry button
            const retryButton = document.createElement("button");
            retryButton.textContent = "Retry";
            retryButton.style.marginTop = "15px";
            retryButton.style.padding = "8px 16px";
            retryButton.style.background = "#007bff";
            retryButton.style.color = "white";
            retryButton.style.border = "none";
            retryButton.style.borderRadius = "4px";
            retryButton.style.cursor = "pointer";
            retryButton.onclick = () => location.reload();

            // Assemble the error display
            errorContainer.appendChild(iconDiv);
            errorContainer.appendChild(titleDiv);
            errorContainer.appendChild(messageDiv);
            errorContainer.appendChild(retryButton);
            overlay.appendChild(errorContainer);
          }
        }
      });
    </script>

    <!-- Fallback error handler for ES6 module loading issues -->
    <script>
      window.addEventListener("error", function (e) {
        if (e.message && e.message.includes("module")) {
          console.error("ES6 Module Loading Error:", e);
          const overlay = document.getElementById("plyr-loading-overlay");
          if (overlay) {
            // Clear existing content safely
            overlay.textContent = "";

            // Create error container
            const errorContainer = document.createElement("div");
            errorContainer.style.textAlign = "center";
            errorContainer.style.color = "#fff";
            errorContainer.style.padding = "20px";

            // Create icon
            const iconDiv = document.createElement("div");
            iconDiv.textContent = "⚠️";
            iconDiv.style.fontSize = "3em";
            iconDiv.style.marginBottom = "10px";

            // Create title
            const titleDiv = document.createElement("div");
            titleDiv.textContent = "Module Loading Error";
            titleDiv.style.fontSize = "1.2em";
            titleDiv.style.marginBottom = "10px";

            // Create description
            const descDiv = document.createElement("div");
            descDiv.textContent =
              "Please refresh the page or try a different browser that supports ES6 modules.";
            descDiv.style.fontSize = "0.9em";
            descDiv.style.opacity = "0.8";

            // Assemble the error display
            errorContainer.appendChild(iconDiv);
            errorContainer.appendChild(titleDiv);
            errorContainer.appendChild(descDiv);
            overlay.appendChild(errorContainer);
          }
        }
      });
    </script>
  </body>
</html>
