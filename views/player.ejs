<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>MKV Video Player</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="preload" as="style" href="/libs/styles/plyr.css" />
    <link rel="stylesheet" href="/libs/styles/plyr.css" />
    <link rel="stylesheet" href="/libs/styles/style.css" />
    <style>
      /* Console Modal Styles */
      .console-modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .console-content {
        background: #1a1a1a;
        border: 1px solid #333;
        border-radius: 8px;
        width: 80%;
        height: 70%;
        max-width: 1000px;
        display: flex;
        flex-direction: column;
        color: #fff;
      }

      .console-header {
        background: #333;
        padding: 10px 15px;
        border-bottom: 1px solid #555;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 8px 8px 0 0;
      }

      .console-close {
        background: none;
        border: none;
        color: #fff;
        font-size: 20px;
        cursor: pointer;
        padding: 0;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .console-close:hover {
        background: #555;
        border-radius: 4px;
      }

      .console-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .console-logs {
        flex: 1;
        padding: 10px;
        overflow-y: auto;
        font-family: "Courier New", monospace;
        font-size: 12px;
        line-height: 1.4;
        background: #000;
      }

      .console-input-area {
        display: flex;
        padding: 10px;
        border-top: 1px solid #555;
        background: #222;
      }

      .console-input {
        flex: 1;
        background: #333;
        border: 1px solid #555;
        color: #fff;
        padding: 8px 12px;
        border-radius: 4px;
        font-family: "Courier New", monospace;
      }

      .console-send {
        background: #007bff;
        color: #fff;
        border: none;
        padding: 8px 15px;
        margin-left: 10px;
        border-radius: 4px;
        cursor: pointer;
      }

      .console-send:hover {
        background: #0056b3;
      }

      .console-log-entry {
        margin: 2px 0;
        padding: 2px 0;
      }

      .console-log-info {
        color: #87ceeb;
      }
      .console-log-error {
        color: #ff6b6b;
      }
      .console-log-warn {
        color: #ffa500;
      }
      .console-log-success {
        color: #90ee90;
      }
    </style>

    <script src="/libs/octopus/subtitles-octopus.js"></script>
  </head>
  <body>
    <main class="container">
      <header style="position: relative">
        <h1>MKV Video Player</h1>
        <a href="/" class="back-btn back-btn-topright">← Back to Home</a>
      </header>

      <!-- Download Status Section -->
      <section class="status-section">
        <div class="status-details" id="status-details">&nbsp;</div>
        <div class="progress-container">
          <div class="progress-bar" id="progress-bar"></div>
        </div>
        <div
          id="preload-indicator"
          class="preload-indicator"
          style="display: none"
        >
          <div class="preload-info">
            <span class="preload-label">Video Buffer:</span>
            <span id="video-buffer-status" class="preload-value">0%</span>
            <span class="preload-separator">|</span>
            <span class="preload-label">Subtitles:</span>
            <span id="subtitle-preload-status" class="preload-value"
              >Loading...</span
            >
          </div>
        </div>
        <div id="loading">Loading video and subtitles, please wait...</div>
        <div id="status-msg"></div>
        <div id="error"></div>
        <button id="retry-btn" class="retry-button">Retry Video Load</button>
      </section>

      <!-- Video Player Section -->
      <section id="video-container" class="video-container-main">
        <div id="plyr-loading-overlay" class="plyr-loading-overlay">
          <div style="text-align: center">
            <div class="plyr-spinner"></div>
            <div class="plyr-loading-text">Loading video player...</div>
          </div>
        </div>
        <div class="video-container-tag">
          <video
            id="player"
            class="hidden-until-plyr video-player-tag"
            controls
            crossorigin
            playsinline
            preload="metadata"
            width="850"
          ></video>
          <!-- Watermark Overlay -->
          <div class="video-watermark"></div>

          <!-- Resume/Start Module -->
          <div
            id="resume-module"
            class="resume-module"
            role="dialog"
            aria-labelledby="resume-title"
            aria-modal="true"
          >
            <div id="resume-module-inner" class="resume-module-inner">
              <div id="resume-title" class="playback-title">
                Resume playback?
              </div>
              <button id="resume-btn" class="resume-button">
                Resume from last position
              </button>
              <button id="restart-btn" class="start-from-beginning-button">
                Start from beginning
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>
    <!-- Embed Box: Hidden in Electron -->
    <div
      id="embed-box"
      style="margin: 32px auto 0 auto; max-width: 600px; text-align: center"
    >
      <label
        for="embed-code"
        style="font-weight: 500; color: #fff; font-size: 1.1em"
      >
        Embed this player:
      </label>
      <input
        id="embed-code"
        type="text"
        readonly
        value=""
        style="
          width: 95%;
          margin-top: 10px;
          padding: 8px;
          font-size: 1em;
          border-radius: 6px;
          border: 1px solid #444;
          background: #222;
          color: #fff;
        "
      />
      <script>
        document.addEventListener("DOMContentLoaded", () => {
          // Check if running in Electron and hide embed box if so
          const isElectron =
            navigator.userAgent.toLowerCase().includes("electron") ||
            typeof window.require !== "undefined" ||
            typeof window.electronAPI !== "undefined";

          const embedBox = document.getElementById("embed-box");

          if (isElectron && embedBox) {
            embedBox.style.display = "none";
            return; // Don't set up embed code if in Electron
          }

          const magnetUrl = decodeURIComponent(
            "<%- encodeURIComponent(magnet) %>"
          );
          const embedInput = document.getElementById("embed-code");
          embedInput.value = `<iframe src="${
            window.location.origin
          }/embed?url=${encodeURIComponent(
            magnetUrl
          )}" width="640" height="360" frameborder="0" allowfullscreen></iframe>`;

          // Add click handler for embed input selection
          embedInput.addEventListener("click", function () {
            this.select();
          });
        });
      </script>
    </div>

    <!-- Console Modal -->
    <div id="console-modal" class="console-modal" style="display: none">
      <div class="console-content">
        <div class="console-header">
          <span>MKV Player Console</span>
          <button id="console-close" class="console-close">&times;</button>
        </div>
        <div class="console-body">
          <div id="console-logs" class="console-logs"></div>
          <div class="console-input-area">
            <input
              type="text"
              id="console-input"
              class="console-input"
              placeholder="Type command..."
            />
            <button id="console-send" class="console-send">Send</button>
          </div>
        </div>
      </div>
    </div>

    <footer class="footer">
      Created with ❤️ by
      <a href="https://github.com/wdallo" target="_blank"> wdallo </a>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/plyr@3.7.8/dist/plyr.polyfilled.js"></script>
    <script type="module">
      // Import the VideoPlayerController class
      import { VideoPlayerController } from "../libs/player.js";

      // Initialize the application with error handling
      document.addEventListener("DOMContentLoaded", async () => {
        try {
          const magnetUrl = decodeURIComponent(
            "<%- encodeURIComponent(magnet) %>"
          );

          if (!magnetUrl) {
            console.error("No magnet URL provided");
            return;
          }

          console.log("Initializing player with magnet:", magnetUrl);

          const player = new VideoPlayerController(magnetUrl);

          // Make player globally accessible for context menu and debugging
          window.player = player;

          // Initialize with error handling
          await player.initialize();

          console.log("✅ Player initialized successfully");
        } catch (error) {
          console.error("❌ Failed to initialize player:", error);

          // Show error in overlay if available
          const overlay = document.getElementById("plyr-loading-overlay");
          if (overlay) {
            // Clear existing content safely
            overlay.textContent = "";

            // Create error container
            const errorContainer = document.createElement("div");
            errorContainer.style.textAlign = "center";
            errorContainer.style.color = "#fff";
            errorContainer.style.padding = "20px";

            // Create icon
            const iconDiv = document.createElement("div");
            iconDiv.textContent = "⚠️";
            iconDiv.style.fontSize = "2em";
            iconDiv.style.marginBottom = "10px";

            // Create title
            const titleDiv = document.createElement("div");
            titleDiv.textContent = "Player Error";
            titleDiv.style.fontSize = "1.2em";
            titleDiv.style.marginBottom = "10px";

            // Create message
            const messageDiv = document.createElement("div");
            messageDiv.textContent = error.message || "Unknown error occurred";
            messageDiv.style.opacity = "0.8";

            // Create retry button
            const retryButton = document.createElement("button");
            retryButton.textContent = "Retry";
            retryButton.style.marginTop = "15px";
            retryButton.style.padding = "8px 16px";
            retryButton.style.background = "#007bff";
            retryButton.style.color = "white";
            retryButton.style.border = "none";
            retryButton.style.borderRadius = "4px";
            retryButton.style.cursor = "pointer";
            retryButton.addEventListener("click", () => location.reload());

            // Assemble the error display
            errorContainer.appendChild(iconDiv);
            errorContainer.appendChild(titleDiv);
            errorContainer.appendChild(messageDiv);
            errorContainer.appendChild(retryButton);
            overlay.appendChild(errorContainer);
          }
        }
      });
    </script>

    <!-- Fallback error handler for ES6 module loading issues -->
    <script>
      window.addEventListener("error", function (e) {
        if (e.message && e.message.includes("module")) {
          console.error("ES6 Module Loading Error:", e);
          const overlay = document.getElementById("plyr-loading-overlay");
          if (overlay) {
            // Clear existing content safely
            overlay.textContent = "";

            // Create error container
            const errorContainer = document.createElement("div");
            errorContainer.style.textAlign = "center";
            errorContainer.style.color = "#fff";
            errorContainer.style.padding = "20px";

            // Create icon
            const iconDiv = document.createElement("div");
            iconDiv.textContent = "⚠️";
            iconDiv.style.fontSize = "3em";
            iconDiv.style.marginBottom = "10px";

            // Create title
            const titleDiv = document.createElement("div");
            titleDiv.textContent = "Module Loading Error";
            titleDiv.style.fontSize = "1.2em";
            titleDiv.style.marginBottom = "10px";

            // Create description
            const descDiv = document.createElement("div");
            descDiv.textContent =
              "Please refresh the page or try a different browser that supports ES6 modules.";
            descDiv.style.fontSize = "0.9em";
            descDiv.style.opacity = "0.8";

            // Assemble the error display
            errorContainer.appendChild(iconDiv);
            errorContainer.appendChild(titleDiv);
            errorContainer.appendChild(descDiv);
            overlay.appendChild(errorContainer);
          }
        }
      });

      // Console functionality
      function initConsole() {
        const consoleModal = document.getElementById("console-modal");
        if (!consoleModal) return;

        const consoleClose = document.getElementById("console-close");
        const consoleLogs = document.getElementById("console-logs");
        const consoleInput = document.getElementById("console-input");
        const consoleSend = document.getElementById("console-send");

        // Handle show console IPC message
        if (window.electronAPI && window.electronAPI.onShowConsoleTab) {
          window.electronAPI.onShowConsoleTab(() => {
            showConsole();
          });

          window.electronAPI.onConsoleLog((event, logData) => {
            addLogEntry(logData);
          });
        }

        function showConsole() {
          consoleModal.style.display = "flex";
          loadConsoleLogs();
        }

        function hideConsole() {
          consoleModal.style.display = "none";
        }

        async function loadConsoleLogs() {
          if (window.electronAPI && window.electronAPI.getConsoleLogs) {
            try {
              const logs = await window.electronAPI.getConsoleLogs();
              consoleLogs.innerHTML = "";
              logs.forEach((log) => addLogEntry(log));
              consoleLogs.scrollTop = consoleLogs.scrollHeight;
            } catch (error) {
              console.error("Failed to load console logs:", error);
            }
          }
        }

        function addLogEntry(logData) {
          const entry = document.createElement("div");
          entry.className = `console-log-entry console-log-${logData.level}`;
          entry.textContent = `[${new Date(logData.timestamp).toLocaleTimeString()}] ${logData.message}`;
          consoleLogs.appendChild(entry);
          consoleLogs.scrollTop = consoleLogs.scrollHeight;
        }

        async function executeCommand(command) {
          if (window.electronAPI && window.electronAPI.executeCommand) {
            try {
              const result = await window.electronAPI.executeCommand(command);
              addLogEntry({
                level: result.success ? "success" : "error",
                message: `> ${command}\n${result.output}`,
                timestamp: new Date().toISOString(),
              });
            } catch (error) {
              addLogEntry({
                level: "error",
                message: `> ${command}\nError: ${error.message}`,
                timestamp: new Date().toISOString(),
              });
            }
          }
        }

        consoleClose.addEventListener("click", hideConsole);
        consoleModal.addEventListener("click", (e) => {
          if (e.target === consoleModal) hideConsole();
        });
        consoleSend.addEventListener("click", () => {
          const command = consoleInput.value.trim();
          if (command) {
            executeCommand(command);
            consoleInput.value = "";
          }
        });
        consoleInput.addEventListener("keypress", (e) => {
          if (e.key === "Enter") {
            const command = consoleInput.value.trim();
            if (command) {
              executeCommand(command);
              consoleInput.value = "";
            }
          }
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && consoleModal.style.display === "flex") {
            hideConsole();
          }
        });
      }

      // Initialize console
      setTimeout(initConsole, 100);
    </script>
  </body>
</html>
