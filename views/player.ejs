<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>MKV Video Player</title>
    <meta name="viewport" content="width=900, initial-scale=1" />

    <link rel="preload" as="style" href="/libs/plyr.css" />
    <link rel="stylesheet" href="/libs/plyr.css" />
    <style>
      body {
        background: #181818;
        color: #fff;
        font-family: "Segoe UI", Arial, sans-serif;
        margin: 0;
        padding: 0;
      }
      /* Download Progress Bar */
      .progress-container {
        width: 100%;
        background: #222;
        border-radius: 8px;
        margin: 16px 0 8px 0;
        height: 22px;
        box-shadow: 0 1px 4px #0006;
        overflow: hidden;
      }
      .progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #00bcd4 0%, #2196f3 100%);
        transition: width 0.3s;
        width: 0%;
      }
      .status-details {
        text-align: center;
        color: #b3e5fc;
        font-size: 1.1em;
        margin-bottom: 8px;
      }
      .container {
        max-width: 900px;
        margin: 40px auto;
        background: #222;
        border-radius: 12px;
        box-shadow: 0 4px 24px #000a;
        padding: 32px 24px 24px 24px;
      }
      h1 {
        text-align: center;
        font-weight: 400;
        margin-bottom: 16px;
        letter-spacing: 1px;
      }
      #loading {
        text-align: center;
        margin: 60px 0 20px 0;
        font-size: 1.4em;
        color: #b3e5fc;
      }
      #status-msg {
        text-align: center;
        margin: 10px 0 20px 0;
        color: #aaa;
        font-size: 1em;
      }
      #error {
        color: #ff5555;
        text-align: center;
        margin: 30px 0 0 0;
        font-size: 1.1em;
        display: none;
      }
      .plyr {
        margin: 0 auto;
        max-width: 850px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 12px #0008;
        background: #000;
        position: relative;
      }

      /* Plyr Loading Spinner */
      .plyr-loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #000;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        border-radius: 8px;
      }

      .plyr-spinner {
        width: 60px;
        height: 60px;
        margin: 0 auto;
        border: 4px solid #333;
        border-top: 4px solid #00bcd4;
        border-radius: 50%;
        animation: plyr-spin 1s linear infinite;
      }

      @keyframes plyr-spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }

      .plyr-loading-text {
        color: #b3e5fc;
        margin-top: 20px;
        font-size: 1.1em;
        text-align: center;
      }
      #step-debug {
        color: #ffe082;
        background: #333;
        padding: 8px;
        margin: 16px 0 0 0;
        text-align: center;
        border-radius: 6px;
        font-size: 0.95em;
        display: none;
      }
      .hidden-until-plyr {
        visibility: hidden;
      }
    </style>
    <script src="/libs/subtitles-octopus.js"></script>
  </head>
  <body>
    <div class="container">
      <h1>MKV Video Player</h1>
      <!-- Download Status Bar and Details -->
      <div class="status-details" id="status-details">&nbsp;</div>
      <div class="progress-container">
        <div class="progress-bar" id="progress-bar"></div>
      </div>
      <div id="loading">Loading video and subtitles, please wait...</div>
      <div id="status-msg"></div>
      <div id="error"></div>
      <button
        id="retry-btn"
        style="
          display: none;
          background: #2196f3;
          color: white;
          border: none;
          padding: 10px 20px;
          border-radius: 5px;
          cursor: pointer;
          margin: 10px 0;
        "
      >
        Retry Video Load
      </button>
      <div id="step-debug"></div>

      <!-- Video Player Container with Loading Overlay -->
      <div
        id="video-container"
        style="
          margin: 0 auto;
          max-width: 850px;
          position: relative;
          border-radius: 8px;
          overflow: hidden;
          box-shadow: 0 2px 12px #0008;
          background: #000;
          min-height: 480px;
          display: none;
        "
      >
        <div id="plyr-loading-overlay" class="plyr-loading-overlay">
          <div style="text-align: center">
            <div class="plyr-spinner"></div>
            <div class="plyr-loading-text">Loading video player...</div>
          </div>
        </div>
        <video
          id="player"
          class="hidden-until-plyr"
          controls
          crossorigin
          playsinline
          preload="metadata"
          width="850"
          autoplay
          style="background: #000; aspect-ratio: 16/9"
        ></video>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/plyr@3.7.8/dist/plyr.polyfilled.js"></script>
    <script src="../libs/player.js"></script>
    <script>
      // Initialize the application
      document.addEventListener("DOMContentLoaded", () => {
        const magnetUrl = "<%= magnet %>";
        const player = new VideoPlayerController(magnetUrl);
        player.initialize();
      });
    </script>
  </body>
</html>
