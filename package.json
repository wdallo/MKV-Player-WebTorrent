{
  "name": "mkv-video-player",
  "productName": "MKV Video Player",
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js --no-debug",
    "electron": "electron .",
    "electron-dev": "set ELECTRON_IS_DEV=1 && electron .",
    "electron-pack": "electron-forge package",
    "electron-make": "electron-forge make",
    "build": "electron-forge make",
    "publish": "electron-forge publish",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "wdallo",
  "license": "ISC",
  "description": "MKV-Player With subtitles reading (.ass) streaming via torrent magnet",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe": "^1.1.2",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "libass-wasm": "^4.1.0",
    "webtorrent": "^2.8.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "electron": "^40.6.1",
    "nodemon": "^3.1.11"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "MKV-Video-Player",
        "asar": false,
        "icon": "favicon.ico"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ],
          "config": {}
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "format": "ULFO"
          }
        }
      ]
    }
  }
}
